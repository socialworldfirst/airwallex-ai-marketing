# ship only the gated page, its images and fonts
*
!.gitignore
!index.html
!images/
!images/**
!fonts/
!fonts/*.woff2
images/.claude/
# one-page slide: gated index, logo, background, fonts only
!onepager/
!onepager/index.html
!onepager/assets/
!onepager/assets/*.webp
!onepager/assets/*.svg
!onepager/fonts/
!onepager/fonts/*.woff2
# research page (standard HTML): gated index, logo, fonts only
!report/
!report/index.html
!report/assets/
!report/assets/*.webp
!report/fonts/
!report/fonts/*.woff2
# one-pager, image version: gated index (images are inside the encrypted page) and fonts only
!onepager/visual/
!onepager/visual/index.html
!onepager/visual/fonts/
!onepager/visual/fonts/*.woff2
